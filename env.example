# GIFT configuration (shared by gift-server and gift-cli)
# Copy this file to .env and edit. Real environment variables and
# command-line flags override values set here.

# --- gift-server only ---------------------------------------------------

# Port to listen on (1-65535)
PORT=8080

# Address to bind to. 127.0.0.1 = this machine only, 0.0.0.0 = all interfaces
HOST=127.0.0.1

# Directory that contains the web UI
UI_DIR=./ui

# --- gift-server and gift-cli -------------------------------------------

# Number of parallel git workers. For the server this is the default when an
# API request does not send "workers"; for the CLI it is the default for -workers.
WORKERS=10
